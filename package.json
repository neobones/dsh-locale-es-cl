{
  "name": "dsh-locale-es-cl",
  "version": "1.0.1",
  "description": "Pack de idioma español de Chile (es-CL) para la interfaz web de DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "Adaptación al español de Chile (ver NOTICE.md)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oskarosan/dsh-locale-es.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "locale",
    "language-pack",
    "i18n",
    "spanish",
    "espanol",
    "es-CL",
    "chile"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build-locale-pack.cjs i18n/catalog.json i18n/es-cl .",
    "check": "node tools/build-locale-pack.cjs i18n/catalog.json i18n/es-cl . --check",
    "audit": "node tools/audit-es.cjs i18n/catalog.json i18n/es-cl",
    "terms": "node tools/apply-terminology.cjs i18n/terminology.json i18n/es-cl --check",
    "delta": "node tools/delta-report.cjs i18n/catalog.json i18n/reference/es.json i18n/es-cl",
    "verify": "node tools/verify-pack.cjs lib/client.js",
    "test": "npm run check && npm run verify"
  },
  "icon": "icon.svg"
}
